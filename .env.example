# =========================================================
# AQIonic Air Quality Intelligence - Environment Configuration
# =========================================================

# 1. Gemini AI API Key (Optional for AI Studio / Copilot)
# In Google AI Studio / Cloud Run, this is automatically injected at runtime.
# For local dev, replace with your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 2. Hosted Application Base URL
# Automatically injected at runtime in Cloud Run deployments.
APP_URL="http://localhost:3000"

# 3. Hopsworks Cloud Feature Store Configuration (Optional)
# If provided, pipeline will sync feature vectors to Hopsworks Cloud Feature Group.
# Leave blank to use local SQLite Feature Store (data/feature_store.db).
HOPSWORKS_API_KEY="YOUR_HOPSWORKS_API_KEY_HERE"
HOPSWORKS_PROJECT="aqi_pridector"
